      {
        "path": "src/smart/view-board/docs.md",
        "sha256": "154e8c3b1875f11db09747a8e19c7d6969c0918bc92ed1ac8de5fea7923279fd"
      }
    ],
    "generated_runtime": []
  },
  "ai_guidance": {
    "use_when": "Use sf-view-board through sf-view layout=\"board\" for records grouped by a status, choice, user or yes/no field, where a person moves them between lanes.",
    "do_not": [
      "Do not save a move in the element; answer sf-view-board-move and call settleMove.",
      "Do not use it for a calendar or a timeline."
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-view layout=\"board\" aria-label=\"Заказы\"></sf-view>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-browser-probes.mjs <free> <set build>"
    ]
  }
}
